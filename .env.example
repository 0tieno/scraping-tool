# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# SQLite database location (directory is created automatically)
DATABASE_PATH=./data/radar.db
# Protects the dashboard + API with a bearer token / basic-auth password. Strongly recommended when exposed beyond localhost.
DASHBOARD_TOKEN=

# --- Scheduling ---
# Cron expression (Africa/Nairobi) for automatic scrape runs. Empty disables the scheduler.
SCRAPE_CRON=0 6-21/3 * * *
DIGEST_CRON=30 7 * * 1-5
TIMEZONE=Africa/Nairobi

# --- Scraper politeness ---
SCRAPER_USER_AGENT=KipeoOpportunityRadar/1.0 (+https://kipeoafrika.com; partnership@kipeoafrika.com)
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_TIMEOUT_MS=45000
SCRAPER_MAX_RETRIES=4

# --- AI analysis (optional) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Opportunities at or above this relevance score are auto-analysed after each scrape (0 disables auto-analysis)
AI_AUTO_ANALYZE_MIN_SCORE=65
AI_MAX_AUTO_ANALYSES_PER_RUN=10

# --- Notifications (optional) ---
DIGEST_MIN_SCORE=50
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=radar@kipeoafrika.com
DIGEST_TO=partnership@kipeoafrika.com
PUBLIC_BASE_URL=http://localhost:8080

# --- Source credentials (optional) ---
# ReliefWeb requires an approved appname: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
