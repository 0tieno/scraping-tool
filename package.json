{
  "name": "kipeo-opportunity-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Opportunity intelligence for Kipeo Afrika: discovers, scores and triages tenders, RFPs, consultancies and grants.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.build.json && npm --prefix web run build",
    "start": "node --disable-warning=ExperimentalWarning dist/cli.js serve",
    "scrape": "tsx src/cli.ts scrape",
    "cli": "tsx src/cli.ts",
    "score": "tsx scripts/score.ts",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/static": "^10.1.6",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
